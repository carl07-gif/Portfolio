{
  "hosting": [
    {
      "site": "carl-portfolio-77777",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.pdf",
          "headers": [
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"Naveen_Carlin_A_Resume.pdf\""
            },
            {
              "key": "Content-Type",
              "value": "application/octet-stream"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
